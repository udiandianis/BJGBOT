[Unit]
Description=Use compressed swap cache for the small bot server
ConditionPathExists=/sys/module/zswap/parameters/enabled
After=systemd-sysctl.service
Before=bjgbot.service bjgbot-agent.service napcat.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo 15 > /sys/module/zswap/parameters/max_pool_percent && echo Y > /sys/module/zswap/parameters/enabled'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
